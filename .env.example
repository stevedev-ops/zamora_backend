NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS (set to your Vercel URL in production)
FRONTEND_URL=http://localhost:5173
# Optional extra CORS origins (e.g. custom domain or preview URL)
CORS_ORIGINS=
# Defaults to <FRONTEND_URL>/portal when omitted
PUBLIC_PORTAL_BASE_URL=http://localhost:5173/portal
DATABASE_URL="postgresql://zamora_user:zamora_pass@localhost:5432/zamora_liquor?schema=public"
TEST_DATABASE_URL="postgresql://zamora_user:zamora_pass@localhost:5432/zamora_liquor_test?schema=public"
JWT_SECRET="dev-owner-jwt-secret-change-me-in-production-32bytes"
PORTAL_JWT_SECRET="dev-portal-jwt-secret-change-me-in-production-32bytes"
JWT_EXPIRES_IN="12h"
PORTAL_JWT_EXPIRES_IN="2h"
# In production (HTTPS), cookies default to secure=true and sameSite=none for Vercel <-> Render
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
EXPOSE_DEV_OTP=true
# Optional initial owner credentials used only when bootstrapping an empty DB
OWNER_EMAIL=owner@zamoraliquor.com
OWNER_PASSWORD=OwnerPass123!
OWNER_NAME="Store Owner"
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
DARAJA_MODE=simulation
DARAJA_SHORTCODE=174379
DARAJA_CALLBACK_URL=http://localhost:4000/api/mpesa/callback

